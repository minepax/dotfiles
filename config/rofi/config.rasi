configuration {
    modes: "run,drun,ssh,filebrowser,combi";
    show-icons: true;
    icon-theme: "Papirus-Dark";
    markup-rows: true;
    display-combi: "";
    combi-display-format: "{text}";
    combi-hide-mode-prefix: true;
    tokenize: true;
    sort: true;
    levenshtein-sort: false;
}

@theme "/home/mahesh/.config/rofi/themes/mahesh-theme.rasi"

* {
    /* theme-changer: begin */
    bg:      #000000;
    bg-sel:  #101010;
    fg:      #ffffff;
    fg-dim:  #5c626c;
    accent:  #2777ff;

    background-color: transparent;
    text-color:       @fg;
    border-color:     #0a0a0a;
    spacing:          0;
    padding:          0;
    margin:           0;
    /* theme-changer: end */
}
