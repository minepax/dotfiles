{
    "layer": "bottom",
    "position": "top",
    "exclusive": true,
    "passthrough": false,
    "spacing": 20,
    "margin": "8",
    "modules-left": [
        "custom/power",
        // "custom/shutdown",
        // "custom/reboot",
        // "custom/lock",
        "custom/themeswitcher",
        "custom/weather"
    ],
    "modules-center": [
        "clock",
        "custom/workspaces"
    ],
    "modules-right": [
        "bluetooth",
        "pulseaudio",
        "backlight",
        // "custom/brightness",
        "battery",
        "network"
    ],

    "bluetooth": {
    	"format": " {status}",
    	"format-disabled": " Disconnected",
    	"format-connected": " {num_connections} Devices",
    	"tooltip-format": "{controller_alias}\t{controller_address}",
    	"tooltip-format-connected": "{device_enumerate}",
    	"tooltip-format-enumerate-connected": "{device_alias}",
        "on-click": "systemsettings kcm_bluetooth"
    },
    "backlight": {
        "device": "intel_backlight",
        "format": "{icon} {percent}%",
        "format-icons": ["", ""],
        "tooltip": false,
        "on-click": "systemsettings kcm_kscreen",
        "scroll-step": 5
    },
    "clock": {
        "interval": 1,
        "format": "{:%r | %A}",
        "tooltip-format": "{calendar}",
        "format-alt": "{:%B %d %Y}"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-bluetooth": "{icon} {volume}%",
        "format-muted": " {volume}%",
        "format-icons": {
            "alsa_output.pci-0000_00_1f.3.analog-stereo": "",
            "alsa_output.pci-0000_00_1f.3.analog-stereo-muted": "",
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "default": [
                "",
                " "
            ]
        },
        "scroll-step": 1,
        "on-click": "pavucontrol",
        "ignored-sinks": ["Easy Effects Sink"]
    },
    "network": {
        "format-wifi": "{icon} Wi-Fi",
        "format-ethernet": " Ethernet",
        "format-disconnected": "󰤭 Disconnected",
        "format-icons": ["󰤟", "󰤢", "󰤥", "󰤨"],
        "tooltip-format-wifi": "{essid} ({signalStrength}%)",
        "tooltip-format-ethernet": "{ifname}",
        "tooltip-format-disconnected": "No Connections",
        "on-click": "systemsettings kcm_networkmanagement"
    },
    "battery": {
        // "bat": "BAT2",
        "interval": 60,
        "format": "{icon} {capacity}%",
        "format-icons": {
            "default": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
            "charging": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"]
        },
        "on-click": "systemsettings kcm_powerdevilprofilesconfig"
    },
    "custom/brightness": {
        "format": "{icon} {percentage}%",
        "format-icons": ["", ""],
        "return-type": "json",
        "exec": "ddcutil --bus 2 getvcp 10 | grep -oP 'current.*?=\\s*\\K[0-9]+' | { read x; echo '{\"percentage\":'${x}'}'; }",
        "tooltip-format": "ddcutil detect | grep 'Mfg id' | head -n 1 | cut -d: -f2 | tr -d ' '",
        "on-scroll-up": "ddcutil --noverify --bus 2 setvcp 10 + 10",
        "on-scroll-down": "ddcutil --noverify --bus 2 setvcp 10 - 10",
        "on-click": "systemsettings kcm_kscreen",
        "signal": 5
    },
    "custom/power": {
        "format": "",
        "on-click": "~/.config/waybar/scripts/power-menu.sh",
        "tooltip": false
    },
    "custom/weather": {
        "format": "{}",
        "interval": 1800,
        "exec": "~/.config/waybar/scripts/weather.sh",
        "return-type": "json",
        "on-click": "~/.local/bin/rofi-location-switcher.sh",
        "tooltip": true
    },
    "custom/workspaces": {
        "format": "{}",
        "return-type": "json",
        "exec": "~/.config/waybar/scripts/workspaces.sh",
    },
    "custom/themeswitcher": {
        "exec": "~/.config/waybar/scripts/theme-switch.sh",
        "return-type": "",
        "interval": "once",
        "signal": 1,
        "on-click": "~/.local/bin/theme_switch.sh",
        "tooltip": false
    }
}
