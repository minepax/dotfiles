{
    "layer": "top",
    "position": "top",
    "exclusive": true,
    "passthrough": false,
    "spacing": 18,
    "margin": "12 12 0 12",
    "modules-left": [
        "hyprland/workspaces"
        // "custom/workspaces"
    ],
    "modules-center": [
        "clock",
        "custom/weather"
    ],
    "modules-right": [
        "pulseaudio",
        // "backlight",
        "custom/brightness",
        "bluetooth",
        // "battery",
        "network"
    ],

    "bluetooth": {
    	"format": " {status}",
    	"format-disabled": " Disconnected",
    	"format-connected": " {num_connections}",
    	"tooltip-format-connected": "{device_enumerate}",
    	"tooltip-format-enumerate-connected": "{device_alias} {device_battery_percentage}%",
        "on-click": "kitty bluetuith"
    },
    "backlight": {
        "device": "intel_backlight",
        "format": "{icon}",
        "format-icons": ["", ""],
        "tooltip-format": "{percent}%",
        "on-click": "systemsettings kcm_kscreen",
        "scroll-step": 5
    },
    "clock": {
        "format": "{:%I:%M %p}",
        "format-alt": "{:%A, %B %d %Y}",
        "tooltip-format": "{calendar}",
        "locale": "en_US.UTF-8",
        "calendar": {
            "mode"          : "months",
            "mode-mon-col"  : 3,
            "on-scroll"     : 1,
            "format": {
                "months":     "{}",
                "days":       "{}",
                "weekdays":   "{}",
                "today":      "<u>{}</u>"
            }
        },
        "actions":  {
                    "on-click-right": "mode",
                    "on-click-middle": "shift_reset",
                    "on-scroll-up": "tz_down",
                    "on-scroll-down": "tz_up",
                    "on-scroll-up": "shift_down",
                    "on-scroll-down": "shift_up"
        }
    },
    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "sort-by-number": true
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-bluetooth": "{icon} {volume}%",
        "format-muted": " {volume}%",
        "format-icons": {
            "alsa_output.pci-0000_00_1f.3.analog-stereo": "",
            "alsa_output.pci-0000_00_1f.3.analog-stereo-muted": "",
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "default": [
                "",
                " "
            ]
        },
        "scroll-step": 1,
        "on-click": "pavucontrol",
        "ignored-sinks": ["Easy Effects Sink"]
    },
    "network": {
        "format-wifi": "{icon} Wi-Fi",
        "format-ethernet": " Ethernet",
        "format-disconnected": "󰤭 Disconnected",
        "format-icons": ["󰤟", "󰤢", "󰤥", "󰤨"],
        "tooltip-format-wifi": "{essid} ({signalStrength}%)",
        "tooltip-format-ethernet": "Ethernet",
        "tooltip-format-disconnected": "No Connections",
        "on-click": "nm-connection-editor"
    },
    "battery": {
        "interval": 60,
        "format": "{icon} {capacity}%",
        "format-icons": {
            "default": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
            "charging": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"]
        },
        "on-click": "systemsettings kcm_powerdevilprofilesconfig"
    },
    "custom/themeswitcher": {
        "exec": "~/.config/waybar/scripts/theme-switch.sh",
        "return-type": "",
        "interval": "once",
        "signal": 1,
        "on-click": "~/.local/bin/theme_switch.sh",
        "tooltip": false
    },
    "custom/weather": {
        "format": "{}",
        "interval": 1800,
        "exec": "~/.config/waybar/scripts/weather.sh",
        "return-type": "json",
        "on-click": "~/.local/bin/rofi-location-switcher.sh",
        "tooltip": true
    },
    "custom/brightness": {
        "format": "{icon} {percentage}%",
        "format-icons": ["", ""],
        "return-type": "json",
        "exec": "ddcutil --bus 2 getvcp 10 | grep -oP 'current.*?=\\s*\\K[0-9]+' | { read x; echo '{\"percentage\":'${x}'}'; }",
        "on-scroll-up": "ddcutil --noverify --bus 2 setvcp 10 + 10",
        "on-scroll-down": "ddcutil --noverify --bus 2 setvcp 10 - 10",
        "on-click": "systemsettings kcm_kscreen",
        "signal": 5,
        "tooltip": false
    }
}
